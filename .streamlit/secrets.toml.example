# Copia este archivo a .streamlit/secrets.toml y reemplaza con tus valores
# reales (ese archivo NO se sube a git — ver .gitignore).
#
# En Streamlit Community Cloud, pega este mismo contenido (con tus valores
# reales) en: tu app -> menú (⋮) -> Settings -> Secrets.
#
# Instrucciones completas en SUPABASE_SETUP.md

[supabase]
url = "https://TU-PROYECTO.supabase.co"
anon_key = "TU-ANON-KEY-AQUI"
